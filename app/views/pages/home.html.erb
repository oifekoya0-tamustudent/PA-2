<% content_for(:title) { "Median S&O - Strategic Solutions" } %>

<div class="landing-container">
  <header class="landing-header">
    <h1 class="logo">Median S&O</h1>
    <p class="tagline">Strategic Solutions for Modern Business</p>
  </header>

  <section class="hero">
    <h2>Driving Success Through Strategy & Operations</h2>
    <p>We help businesses optimize their operations and achieve sustainable growth through data-driven strategies and proven methodologies.</p>
    <a href="#contact" class="cta-button">Get Started</a>
  </section>

  <section class="services">
    <h3>Our Services</h3>
    <div class="services-grid">
      <div class="service-card">
        <h4>Strategic Planning</h4>
        <p>Develop comprehensive strategies aligned with your business goals and market opportunities.</p>
      </div>
      <div class="service-card">
        <h4>Operations Excellence</h4>
        <p>Streamline processes and improve efficiency across your organization.</p>
      </div>
      <div class="service-card">
        <h4>Data Analytics</h4>
        <p>Transform data into actionable insights for better decision-making.</p>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <h3>Contact Us</h3>
    <p>Ready to transform your business? Let's talk.</p>
    <p class="contact-email">contact@medianso.com</p>
  </section>

  <footer class="landing-footer">
    <p>&copy; <%= Time.current.year %> Median S&O. All rights reserved.</p>
  </footer>
</div>
